+++ b/tools/island-menu-checks.mjs
@@ -0,0 +1,16 @@
+import { button, waitMode } from './island-e2e-helpers.mjs';
+
+/** Open actual disclosure controls before choosing an action; never force a covered click. */
+export async function openIslandMenu(page, group, touch = false) {
+    const activate = control => touch ? control.tap() : control.click();
+    await activate(button(page, 'しまのメニュー'));
+    if (group) {
+        const details = page.locator(`dialog[open] [data-home-group="${group}"]`);
+        if (!await details.evaluate(element => element.open)) await activate(details.locator('summary'));
+    }
+}
+export async function closeIslandAlbumHome(page) {
+    await button(page, 'アルバムから もどる').click();
+    if (await page.locator('.island-page[data-mode="keepsakes"]').count()) await button(page, 'しまへ もどる').click();
+    await waitMode(page, 'home');
+}
